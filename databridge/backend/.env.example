# ─── DataBridge AI — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
# Found in: Microsoft Foundry → your resource → Keys and Endpoint.
# Use the resource URL only; the backend adds /openai/v1/ automatically.
# Either .openai.azure.com or .services.ai.azure.com endpoints are supported.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.services.ai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
# Use the exact deployment name from Foundry. It may differ from the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol
# The Foundry OpenAI-compatible v1 API does not use AZURE_OPENAI_API_VERSION.
# Deploy text-embedding-3-small separately for approved-mapping RAG memory.
# For Foundry serverless deployments, the backend calls /openai/v1/embeddings automatically.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ── Optional: Default DB credentials for testing ─────────────────────────────
# These are never required — users enter credentials in the UI
# TEST_SQL_HOST=localhost
# TEST_SQL_PORT=1433
# TEST_SQL_DB=testdb
# TEST_SQL_USER=sa
# TEST_SQL_PASS=YourPassword123
